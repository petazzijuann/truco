{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "server": {
      "root": ".",
      "runtime": "container"
    }
  },
  "rewrites": [
    { "source": "/ws", "destination": { "service": "server" } },
    { "source": "/health", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
